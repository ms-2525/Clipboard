<Window x:Class="Clip.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="660" Height="640"
        WindowStyle="None" Background="{DynamicResource App}"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource FontBodySize}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        >

  <Window.Resources>
    <Style x:Key="TabButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg55}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Keycap" TargetType="Border">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="{DynamicResource KeycapBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource KeycapLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="KeycapText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontKeycapSize}"/>
      <Setter Property="LineHeight" Value="{DynamicResource FontKeycapLine}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>

      <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" Background="{DynamicResource App}" CornerRadius="12"
          BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
          MouseLeftButtonDown="OnShellMouseDown">

    <Grid x:Name="ShellContent">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="ShellShift"/>
      </Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="38"/>
      </Grid.RowDefinitions>

      <!-- Search band: flat, one hairline, no rounded container (DESIGN-layout Â§4.1) -->
      <Border x:Name="HeaderBand" Grid.Row="0" Height="58" Padding="12,0,16,0"
              BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="32"/>
          </Grid.ColumnDefinitions>

          <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left">
            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Fg40}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Viewbox>

          <Grid Grid.Column="1" Margin="12,0,10,0">
            <TextBox x:Name="Search" FontSize="{DynamicResource FontBodySize}" FontWeight="Normal"
                     Foreground="{DynamicResource Fg75}" CaretBrush="{DynamicResource Accent}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     VerticalContentAlignment="Center"
                     TextChanged="OnSearchChanged"
                     AutomationProperties.Name="Search clips">
              <!-- Declared here so the search box's own menu uses the app's skin, not Aero2's. -->
              <TextBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Cut" Command="ApplicationCommands.Cut"/>
                  <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                  <MenuItem Header="Paste" Command="ApplicationCommands.Paste"/>
                  <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll"/>
                </ContextMenu>
              </TextBox.ContextMenu>
            </TextBox>
            <TextBlock x:Name="PlaceholderText" Text="Search Clipboard" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}"
                       Foreground="{DynamicResource Placeholder}" IsHitTestVisible="False"
                       VerticalAlignment="Center"/>
          </Grid>

          <Button x:Name="ClearSearch" Grid.Column="2" Style="{StaticResource IconButton}"
                  Width="32" Height="32"
                  Visibility="Collapsed" Click="OnClearSearch" ToolTip="Clear search"
                  AutomationProperties.Name="Clear search">
            <Viewbox Width="12" Height="12">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Fg48}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <!-- Tabs: flat text + 2 px underline, never a TabControl (RESEARCH-tabs-pinning Â§5.1).
           The "+" sits after the last tab, where the eye looks for it (Ctrl+T still works
           when the strip is long enough to push it out of view). -->
      <Border Grid.Row="1" Height="54" Padding="12,10,16,10"
              BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Orientation="Horizontal">
            <ItemsControl x:Name="TabItems" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource TabButton}" Tag="{Binding}" Click="OnTabClick"
                          Margin="0,0,20,0">
                    <Grid Height="34">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="2"/>
                      </Grid.RowDefinitions>
                      <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TabName" Text="{Binding Name}" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}"
                                   FontWeight="Medium"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock x:Name="TabCount" Text="{Binding CountText}" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg48}"
                                   Typography.NumeralAlignment="Tabular"/>
                      </StackPanel>
                      <Border x:Name="TabUnderline" Grid.Row="1" Height="2"
                              Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                    </Grid>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter TargetName="TabName" Property="Foreground" Value="{DynamicResource Fg}"/>
                      <Setter TargetName="TabName" Property="FontWeight" Value="SemiBold"/>
                      <Setter TargetName="TabUnderline" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="True"/>
                        <Condition Binding="{Binding IsPinned}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <Setter TargetName="TabUnderline" Property="Background" Value="{DynamicResource Amber}"/>
                    </MultiDataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource IconButton}"
                    Width="32" Height="32"
                    VerticalAlignment="Center" Click="OnNewTabClick"
                    ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab">
              <Viewbox Width="14" Height="14">
                <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource Fg48}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Viewbox>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- List -->
      <Grid Grid.Row="2">
        <!--
          Images tab (docs\DESIGN-v2-ui.md Â§3.2): a dominant preview over the filmstrip below.
          The pane is a view of the selected image; it never changes size when the selection moves.
        -->
        <Border x:Name="ImagesPane" Visibility="Collapsed" Height="316" Margin="8,8,8,0"
                VerticalAlignment="Top" Background="{DynamicResource Field}"
                CornerRadius="14" ClipToBounds="True">
          <Grid>
            <Image x:Name="PreviewImage" Margin="10" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Decode failure degrades visibly, never to an empty box. -->
            <StackPanel x:Name="PreviewFallback" Visibility="Collapsed" Margin="28"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Preview unavailable" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" FontWeight="Medium"
                         Foreground="{DynamicResource Fg75}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="PreviewFallbackNote" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}" TextWrapping="Wrap"
                         Foreground="{DynamicResource Fg55}" TextAlignment="Center"
                         HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <Border Height="24" Padding="8,0" CornerRadius="7" Margin="10"
                    Background="{DynamicResource App}" IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock x:Name="PreviewCounterText" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}" FontWeight="Medium"
                         Foreground="{DynamicResource Fg55}" VerticalAlignment="Center"
                         Typography.NumeralAlignment="Tabular"/>
            </Border>
          </Grid>
        </Border>

        <ListBox x:Name="History" Background="Transparent" BorderThickness="0" Padding="2,8,2,8"
                 AlternationCount="2"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Item"
                 VirtualizingPanel.CacheLength="1,1"
                 ItemTemplate="{StaticResource ClipRowTemplate}"
                 ItemContainerStyle="{StaticResource ClipRowItem}"
                 ScrollViewer.ScrollChanged="OnListScrolled"
                 SizeChanged="OnScrollCueSizeChanged"
                 SelectionChanged="OnHistorySelectionChanged"
                 PreviewMouseWheel="OnStripWheel"
                 MouseMove="OnListMouseMove"
                 MouseLeave="OnListMouseLeave"
                 IsVisibleChanged="OnHistoryVisibleChanged"
                 MouseDoubleClick="OnRowDoubleClick"
                 PreviewMouseRightButtonDown="OnRowRightClick"
                 AutomationProperties.Name="Clipboard history">
        </ListBox>

        <!-- Bottom edge: never a sliced glyph (owner: 3rd recurrence). Height and fill come from code. -->
        <Border x:Name="EdgeMask" Height="0" VerticalAlignment="Bottom"
                Background="{DynamicResource App}" IsHitTestVisible="False"
                Loaded="OnEdgeMaskLoaded"/>

        <!-- Scroll cue: the list scrolls by item, so a part row at the edge needs a position signal. -->
        <Canvas x:Name="ScrollCue" Width="8" HorizontalAlignment="Right" Margin="0,8,2,8"
                IsHitTestVisible="False" Opacity="0" ClipToBounds="True">
          <Border x:Name="ScrollCueThumb" Width="4" Height="40" CornerRadius="2"
                  Background="{DynamicResource ScrollThumb}"/>
        </Canvas>

        <!-- Empty states (docs\DESIGN-antislop.md Â§7) -->
        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Margin="0,44,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Width="360">
          <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource Surface}"
                  BorderBrush="{DynamicResource Hairline}" BorderThickness="1" HorizontalAlignment="Center">
            <Viewbox Width="20" Height="20">
              <Path x:Name="EmptyIcon" Data="{StaticResource IconClipboard}" Stroke="{DynamicResource Muted}"
                    StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
          </Border>
          <TextBlock x:Name="EmptyTitle" Text="No clips yet" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" FontWeight="Medium"
                     Foreground="{DynamicResource Fg75}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
          <TextBlock x:Name="EmptySub" Text="Copy text or an image anywhere, and it appears here."
                     FontSize="{DynamicResource FontCaptionSize}" LineHeight="{DynamicResource FontCaptionLine}" Foreground="{DynamicResource Muted}"
                     TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <StackPanel x:Name="EmptyKeyRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
            <Border Style="{StaticResource Keycap}">
              <TextBlock x:Name="EmptyKey" Text="Alt+V" Style="{StaticResource KeycapText}"/>
            </Border>
            <TextBlock x:Name="EmptyKeyHint" Text="Open this list from any app" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}"
                       Foreground="{DynamicResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="EmptyNote" Text="" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}" Foreground="{DynamicResource Muted}"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Tab-name editor (Ctrl+T) -->
        <Border x:Name="TabEditor" Visibility="Collapsed" VerticalAlignment="Top" Margin="20,14,20,0"
                Background="{DynamicResource Raised}" BorderBrush="{DynamicResource ControlLine}"
                BorderThickness="1" CornerRadius="10" Padding="12" Panel.ZIndex="20">
          <StackPanel>
            <TextBox x:Name="TabNameBox" FontSize="{DynamicResource FontBodySize}" Foreground="{DynamicResource Fg}"
                     Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource Accent}"
                    />
            <TextBlock x:Name="TabNameError" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}" Foreground="{DynamicResource Error}"
                       Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            <TextBlock Text="Enter to create, Esc to cancel." FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}"
                       Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <!-- Tab delete confirmation -->
        <Border x:Name="TabConfirm" Visibility="Collapsed" Width="470" VerticalAlignment="Center"
                HorizontalAlignment="Center" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="14" Padding="18"
                Panel.ZIndex="20">
          <StackPanel>
            <TextBlock x:Name="TabConfirmText" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" Foreground="{DynamicResource Fg75}"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button x:Name="TabConfirmCancel" Style="{StaticResource SecondarySmall}" Click="OnTabConfirmCancel" Content="Cancel"/>
              <Button Style="{StaticResource DangerSmall}" Margin="10,0,0,0" Click="OnTabConfirmDelete" Content="Delete tab"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Ctrl+M tab picker -->
        <Border x:Name="Picker" Visibility="Collapsed" Width="320" VerticalAlignment="Top"
                HorizontalAlignment="Center" Margin="0,14,0,0" Background="{DynamicResource Raised}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="12" Padding="8"
                Panel.ZIndex="21">
          <ListBox x:Name="PickerList" Background="Transparent" BorderThickness="0"
                   FocusVisualStyle="{x:Null}"
                   ScrollViewer.VerticalScrollBarVisibility="Hidden"
                   MouseDoubleClick="OnPickerCommitClick"
                   MouseLeftButtonUp="OnPickerCommitClick">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Pill" Background="Transparent" CornerRadius="10" Padding="10,8"
                              BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StateHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource RowSelected}"/>
                          <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>

                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Index}" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}" Foreground="{DynamicResource Fg48}"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource FontCaptionSize}" LineHeight="{DynamicResource FontCaptionLine}"
                             Foreground="{DynamicResource Fg75}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}"
                             Foreground="{DynamicResource Fg48}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <!-- Status bar: the selected clip's provenance left, counts + key hints right (directive Â§2 rev 3). -->
      <Border Grid.Row="3" Padding="12,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SelectionBar" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}"
                     Foreground="{DynamicResource Fg55}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Margin="0,0,14,0"
                     AutomationProperties.Name="Selected clip source, title and time"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="StatusCount" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}" FontWeight="Medium"
                       Foreground="{DynamicResource Fg48}" VerticalAlignment="Center" Margin="0,0,14,0"
                       Typography.NumeralAlignment="Tabular"/>
            <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Style="{StaticResource KeycapText}"/></Border>
            <TextBlock Text="paste" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}" Foreground="{DynamicResource Fg55}"
                       Margin="8,0,14,0" VerticalAlignment="Center"/>
            <Border Style="{StaticResource Keycap}"><TextBlock Text="F2" Style="{StaticResource KeycapText}"/></Border>
            <TextBlock Text="edit" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}" Foreground="{DynamicResource Fg55}"
                       Margin="8,0,14,0" VerticalAlignment="Center"/>
            <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource KeycapText}"/></Border>
            <TextBlock Text="hide" FontSize="{DynamicResource FontMicroSize}" LineHeight="{DynamicResource FontMicroLine}" Foreground="{DynamicResource Fg55}"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
