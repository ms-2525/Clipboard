<Window x:Class="Clip.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="550" Height="520"
        WindowStyle="None" Background="{DynamicResource App}"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        >

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="TabButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg55}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Keycap" TargetType="Border">
      <Setter Property="Height" Value="18"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource KeycapBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource KeycapLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="KeycapText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="LineHeight" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>

      <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MenuStyle" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
    </Style>

    <Style x:Key="MenuItemStyle" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" Background="{DynamicResource App}" CornerRadius="8"
          BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
          MouseLeftButtonDown="OnShellMouseDown">

    <Grid x:Name="ShellContent">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="ShellShift"/>
      </Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="32"/>
      </Grid.RowDefinitions>

      <!-- Search band: flat, one hairline, no rounded container (DESIGN-layout §4.1) -->
      <Border x:Name="HeaderBand" Grid.Row="0" Height="48" Padding="18,0"
              BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
          </Grid.ColumnDefinitions>

          <Viewbox Grid.Column="0" Width="14" Height="14" HorizontalAlignment="Left">
            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Fg40}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Viewbox>

          <Grid Grid.Column="1" Margin="10,0,8,0">
            <TextBox x:Name="Search" FontSize="14" FontWeight="Normal"
                     Foreground="{DynamicResource Fg75}" CaretBrush="{DynamicResource Accent}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     VerticalContentAlignment="Center"
                     TextChanged="OnSearchChanged"
                     AutomationProperties.Name="Search clips"/>
            <TextBlock x:Name="PlaceholderText" Text="Search Clipboard" FontSize="14" LineHeight="20"
                       Foreground="{DynamicResource Placeholder}" IsHitTestVisible="False"
                       VerticalAlignment="Center"/>
          </Grid>

          <Button x:Name="ClearSearch" Grid.Column="2" Style="{StaticResource FlatButton}"
                  Width="24" Height="24" Visibility="Collapsed"
                  Click="OnClearSearch" ToolTip="Clear search"
                  AutomationProperties.Name="Clear search">
            <Viewbox Width="10" Height="10">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Fg48}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <!-- Tabs: flat text + 2 px underline, never a TabControl (RESEARCH-tabs-pinning §5.1) -->
      <Border Grid.Row="1" Height="45" Padding="18,8"
              BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="TabItems" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource TabButton}" Tag="{Binding}" Click="OnTabClick"
                          Margin="0,0,16,0">
                    <Grid Height="28">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="2"/>
                      </Grid.RowDefinitions>
                      <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TabName" Text="{Binding Name}" FontSize="13" LineHeight="18"
                                   FontWeight="Medium"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock x:Name="TabCount" Text="{Binding CountText}" FontSize="10" LineHeight="14"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg48}"
                                   Typography.NumeralAlignment="Tabular"/>
                      </StackPanel>
                      <Border x:Name="TabUnderline" Grid.Row="1" Height="2"
                              Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                    </Grid>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter TargetName="TabName" Property="Foreground" Value="{DynamicResource Fg}"/>
                      <Setter TargetName="TabName" Property="FontWeight" Value="SemiBold"/>
                      <Setter TargetName="TabUnderline" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="True"/>
                        <Condition Binding="{Binding IsPinned}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <Setter TargetName="TabUnderline" Property="Background" Value="{DynamicResource Amber}"/>
                    </MultiDataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Button Grid.Column="1" Style="{StaticResource FlatButton}" Width="16" Height="16"
                  Margin="16,0,0,0" VerticalAlignment="Center" Click="OnNewTabClick"
                  ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab">
            <Viewbox Width="12" Height="12">
              <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource Fg48}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <!-- List -->
      <Grid Grid.Row="2">
        <ListBox x:Name="History" Background="Transparent" BorderThickness="0" Padding="6"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Item"
                 VirtualizingPanel.CacheLength="1,1"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnRowDoubleClick"
                 PreviewMouseRightButtonDown="OnRowRightClick"
                 AutomationProperties.Name="Clipboard history">
          <ListBox.Resources>
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.Resources>

          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel x:Name="ItemRoot" Background="Transparent">
                <StackPanel.RenderTransform>
                  <TranslateTransform/>
                </StackPanel.RenderTransform>

                <!-- Time section header: a band, not a row (DESIGN-layout §8) -->
                <Grid x:Name="SectionBand" Margin="12,0,12,8" Visibility="{Binding ShowSection, Converter={StaticResource BoolToVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="SectionText" Text="{Binding SectionLabel}"
                             FontSize="10" LineHeight="14" FontWeight="SemiBold"
                             Foreground="{DynamicResource Fg48}"/>
                  <Border Grid.Column="1" Height="1" Margin="8,0,0,0" VerticalAlignment="Center"
                          Background="{DynamicResource Divider}"/>
                </Grid>

                <Border x:Name="RowRoot" Background="Transparent" CornerRadius="12">
                  <Grid>
                    <Border x:Name="HoverLayer" Background="{DynamicResource RowHover}" CornerRadius="12"
                            Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="SelLayer" Background="{DynamicResource RowSelected}" CornerRadius="12"
                            Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="Ring" BorderBrush="{DynamicResource SelectionRing}" BorderThickness="1"
                            CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="Rail" Width="2" Height="24" CornerRadius="1"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"
                            Background="{DynamicResource SelectionRail}" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="PulseLayer" Background="{DynamicResource PulseFill}"
                            BorderBrush="{DynamicResource PulseRing}" BorderThickness="1"
                            CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>

                    <Grid Margin="12,8">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>

                      <Border x:Name="TypeTile" Grid.Row="0" Grid.Column="0" Width="22" Height="22"
                              CornerRadius="8" Background="{DynamicResource TileBackground}"
                              VerticalAlignment="Top">
                        <Viewbox Width="12" Height="12">
                          <Path Data="{Binding KindIcon}" Stroke="{DynamicResource Fg48}" StrokeThickness="2"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                      </Border>

                      <Border x:Name="ThumbTile" Grid.Row="0" Grid.Column="0" Width="22" Height="22"
                              CornerRadius="8" Background="{DynamicResource TileBackground}"
                              VerticalAlignment="Top" Visibility="Collapsed">
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                      </Border>

                      <TextBlock x:Name="Body" Grid.Row="0" Grid.Column="2"
                                 Text="{Binding BodyText}" FontSize="13" LineHeight="18"
                                 FontWeight="Normal" Foreground="{DynamicResource Fg55}"
                                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                 Height="18"/>

                      <Border x:Name="MetaBlock" Grid.Row="1" Grid.ColumnSpan="3"
                              Margin="0,8,0,0" Padding="0,8,0,0"
                              BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MetaApp}" FontSize="11" LineHeight="14"
                                       FontWeight="Medium" Foreground="{DynamicResource Fg55}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MetaTime}" Margin="8,0,0,0" FontSize="11" LineHeight="14"
                                       FontWeight="Normal" Foreground="{DynamicResource Fg55}"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                          </StackPanel>
                          <Border x:Name="Badge" Grid.Column="1" Height="16" Padding="6,0" CornerRadius="8"
                                  Background="{DynamicResource BadgeBackground}" VerticalAlignment="Center"
                                  Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding MoreLines}" FontSize="9" LineHeight="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg48}" VerticalAlignment="Center"/>
                          </Border>
                        </Grid>
                      </Border>

                      <Border x:Name="PreviewHost" Grid.Row="2" Grid.Column="2"
                              Margin="0,8,0,0" MaxHeight="150" ClipToBounds="True" Visibility="Collapsed">
                        <ContentControl x:Name="RichHost"/>
                      </Border>
                    </Grid>
                  </Grid>
                </Border>
              </StackPanel>

              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                  <Setter TargetName="TypeTile" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="ThumbTile" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="Body" Property="FontWeight" Value="Normal"/>
                </DataTrigger>

                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                  <Trigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.100"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                         To="0" Duration="0:0:0.100"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.ExitActions>
                </Trigger>

                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="SelLayer" Property="Opacity" Value="1"/>
                  <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                  <Setter TargetName="Rail" Property="Opacity" Value="1"/>
                  <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Fg75}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty states (docs\DESIGN-antislop.md §7) -->
        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Margin="0,40,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Width="300">
          <Border Width="40" Height="40" CornerRadius="16" Background="{DynamicResource Raised}"
                  BorderBrush="{DynamicResource Hairline}" BorderThickness="1" HorizontalAlignment="Center">
            <Viewbox Width="18" Height="18">
              <Path x:Name="EmptyIcon" Data="{StaticResource IconClipboard}" Stroke="{DynamicResource Muted}"
                    StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
          </Border>
          <TextBlock x:Name="EmptyTitle" Text="No clips yet" FontSize="14" LineHeight="20" FontWeight="Medium"
                     Foreground="{DynamicResource Fg75}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
          <TextBlock x:Name="EmptySub" Text="Copy text or an image anywhere, and it appears here."
                     FontSize="12" LineHeight="18" Foreground="{DynamicResource Muted}"
                     TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <StackPanel x:Name="EmptyKeyRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Border Style="{StaticResource Keycap}">
              <TextBlock x:Name="EmptyKey" Text="Alt+V" Style="{StaticResource KeycapText}"/>
            </Border>
            <TextBlock x:Name="EmptyKeyHint" Text="Open this list from any app" FontSize="11" LineHeight="16"
                       Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="EmptyNote" Text="" FontSize="11" LineHeight="16" Foreground="{DynamicResource Muted}"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Tab-name editor (Ctrl+T) -->
        <Border x:Name="TabEditor" Visibility="Collapsed" VerticalAlignment="Top" Margin="18,12,18,0"
                Background="{DynamicResource Raised}" BorderBrush="{DynamicResource ControlLine}"
                BorderThickness="1" CornerRadius="8" Padding="10" Panel.ZIndex="20">
          <StackPanel>
            <TextBox x:Name="TabNameBox" FontSize="13" Foreground="{DynamicResource Fg}"
                     Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource Accent}"
                    />
            <TextBlock x:Name="TabNameError" FontSize="11" LineHeight="16" Foreground="{DynamicResource Error}"
                       Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            <TextBlock Text="Enter to create, Esc to cancel." FontSize="11" LineHeight="16"
                       Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- Tab delete confirmation -->
        <Border x:Name="TabConfirm" Visibility="Collapsed" Width="400" VerticalAlignment="Center"
                HorizontalAlignment="Center" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="12" Padding="16"
                Panel.ZIndex="20">
          <StackPanel>
            <TextBlock x:Name="TabConfirmText" FontSize="13" LineHeight="18" Foreground="{DynamicResource Fg75}"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="TabConfirmCancel" Style="{StaticResource FlatButton}" Padding="12,6"
                      Click="OnTabConfirmCancel" Foreground="{DynamicResource Fg55}" FontSize="12"
                      Content="Cancel"/>
              <Button Style="{StaticResource FlatButton}" Padding="12,6" Margin="12,0,0,0"
                      Click="OnTabConfirmDelete" Foreground="{DynamicResource Error}" FontSize="12"
                      FontWeight="SemiBold" Content="Delete tab"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Ctrl+M tab picker -->
        <Border x:Name="Picker" Visibility="Collapsed" Width="270" VerticalAlignment="Top"
                HorizontalAlignment="Center" Margin="0,12,0,0" Background="{DynamicResource Raised}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="6"
                Panel.ZIndex="21">
          <ListBox x:Name="PickerList" Background="Transparent" BorderThickness="0"
                   FocusVisualStyle="{x:Null}"
                   ScrollViewer.VerticalScrollBarVisibility="Hidden"
                   MouseDoubleClick="OnPickerCommitClick"
                   MouseLeftButtonUp="OnPickerCommitClick">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Pill" Background="Transparent" CornerRadius="6" Padding="8,6"
                              BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource RowSelected}"/>
                          <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Index}" FontSize="10" LineHeight="16" Foreground="{DynamicResource Fg48}"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" LineHeight="16"
                             Foreground="{DynamicResource Fg75}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="10" LineHeight="16"
                             Foreground="{DynamicResource Fg48}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <!-- Status bar -->
      <Border Grid.Row="3" Padding="18,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
        <Grid>
          <TextBlock x:Name="StatusCount" FontSize="11" LineHeight="16" FontWeight="Medium"
                     Foreground="{DynamicResource Fg48}" VerticalAlignment="Center"
                     Typography.NumeralAlignment="Tabular"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Style="{StaticResource KeycapText}"/></Border>
            <TextBlock Text="paste" FontSize="11" LineHeight="16" Foreground="{DynamicResource Fg55}"
                       Margin="6,0,12,0" VerticalAlignment="Center"/>
            <Border Style="{StaticResource Keycap}"><TextBlock Text="F2" Style="{StaticResource KeycapText}"/></Border>
            <TextBlock Text="edit" FontSize="11" LineHeight="16" Foreground="{DynamicResource Fg55}"
                       Margin="6,0,12,0" VerticalAlignment="Center"/>
            <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource KeycapText}"/></Border>
            <TextBlock Text="hide" FontSize="11" LineHeight="16" Foreground="{DynamicResource Fg55}"
                       Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
