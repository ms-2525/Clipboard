<Window x:Class="Clip.UI.NotificationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification preview"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource UiFont}">

  <!-- A ghost of the toast: same footprint, no content. Colours are resolved in
       Apply() so a theme switch is picked up without recreating the window. -->
  <Grid x:Name="Shell" MouseLeftButtonDown="OnDragStart">
    <Rectangle x:Name="Wash" RadiusX="12" RadiusY="12"
               StrokeThickness="1" StrokeDashArray="4 3"/>
    <TextBlock x:Name="Label" Text="NOTIFICATION PREVIEW" FontSize="10" LineHeight="14"
               FontWeight="SemiBold"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsHitTestVisible="False"/>
  </Grid>
</Window>
