<Window x:Class="Clip.UI.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="900" Height="700"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App}" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <wv2:WebView2 x:Name="Web" />
    <TextBlock x:Name="Notice" Visibility="Collapsed"
               Margin="32" TextWrapping="Wrap" TextAlignment="Center"
               VerticalAlignment="Center" HorizontalAlignment="Center"
               Foreground="{DynamicResource Fg75}" FontSize="14"/>
  </Grid>
</Window>
