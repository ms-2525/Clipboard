<Window x:Class="Clip.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="714" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">

  <Window.Resources>
    <Style x:Key="Sect" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/><Setter Property="LineHeight" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg48}"/>
      <Setter Property="Margin" Value="0,12,0,12"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="18"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Desc" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="LineHeight" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="Err" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="LineHeight" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource Error}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="18"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Width" Value="90"/><Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Field}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,0"/><Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="CaretBrush" Value="{DynamicResource AccentText}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" CornerRadius="8"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="Background" Value="{DynamicResource AccentText}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource OnAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Raised}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Row-sized versions for actions that sit on a settings row. -->
    <Style x:Key="GhostSmall" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style x:Key="PrimarySmall" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="10,0"/>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="38" Height="22" CornerRadius="11"
                    Background="{DynamicResource Field}"
                    BorderBrush="{DynamicResource ControlLine}" BorderThickness="1">
              <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                      Background="{DynamicResource Muted}" Margin="2,0,0,0"
                      HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentText}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource OnAccent}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="P" Background="Transparent" CornerRadius="6"
                    BorderBrush="Transparent" BorderThickness="1" Padding="10,4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="P" Property="Background" Value="{DynamicResource Raised}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="P" Property="Background" Value="{DynamicResource AccentText}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="P" Property="BorderBrush" Value="{DynamicResource OnAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Field}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="2"/>
    </Style>

    <Style x:Key="Pin" TargetType="ToggleButton">
      <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="{DynamicResource ControlLine}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Raised}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentText}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource App}" CornerRadius="14"
          BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header band, also the drag handle. -->
      <Border Grid.Row="0" Height="48" Padding="20,0" Background="Transparent"
              BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnDrag">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Settings" FontSize="13" LineHeight="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource Fg}"/>
          <TextBlock Text="Changes apply when you save." FontSize="11" LineHeight="16"
                     Foreground="{DynamicResource Muted}"/>
        </StackPanel>
      </Border>

      <!-- Flat tabs: text + 2px accent underline, no TabControl chrome. -->
      <Border Grid.Row="1" Height="45" Padding="20,10"
              BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal">
          <StackPanel x:Name="TabGeneral" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="OnGeneralTab">
            <TextBlock x:Name="TabGeneralText" Text="General" FontSize="13" LineHeight="18"/>
            <Rectangle x:Name="TabGeneralBar" Height="2" Margin="0,4,0,0"
                       Fill="{DynamicResource AccentText}"/>
          </StackPanel>
          <StackPanel x:Name="TabNotification" Background="Transparent" Cursor="Hand"
                      Margin="18,0,0,0" MouseLeftButtonUp="OnNotificationTab">
            <TextBlock x:Name="TabNotificationText" Text="Notification" FontSize="13" LineHeight="18"/>
            <Rectangle x:Name="TabNotificationBar" Height="2" Margin="0,4,0,0"
                       Fill="{DynamicResource AccentText}" Visibility="Collapsed"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 672 px content column: 714 window − 2 border − 2 × 20 padding. -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Focusable="False">
        <StackPanel Width="672" HorizontalAlignment="Center" Margin="20,8,20,20">

          <StackPanel x:Name="PanelGeneral">
            <TextBlock Text="HOTKEYS" Style="{StaticResource Sect}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Style="{DynamicResource Field}"
                           Width="150" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                           PreviewKeyDown="OnHotkeyKeyDown"/>
                  <TextBlock Text="Open the list" Style="{StaticResource Title}"/>
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                  <TextBox x:Name="PlainHotkeyBox" DockPanel.Dock="Right" Style="{DynamicResource Field}"
                           Width="150" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                           PreviewKeyDown="OnHotkeyKeyDown"/>
                  <TextBlock Text="Paste as plain text" Style="{StaticResource Title}"/>
                </DockPanel>
                <TextBlock Text="Click a field, then press the keys you want."
                           Style="{StaticResource Desc}"/>
                <TextBlock x:Name="HotkeyError" Style="{StaticResource Err}"/>
              </StackPanel>
            </Border>

            <TextBlock Text="HISTORY" Style="{StaticResource Sect}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel>
                  <DockPanel>
                    <TextBox x:Name="MaxItemsBox" DockPanel.Dock="Right" Style="{DynamicResource Field}"
                             PreviewTextInput="OnNumberInput"/>
                    <StackPanel>
                      <TextBlock Text="Clips kept" Style="{StaticResource Title}"/>
                      <TextBlock Text="10 to 10,000. Pinned clips are kept separately."
                                 Style="{StaticResource Desc}"/>
                    </StackPanel>
                  </DockPanel>
                  <TextBlock x:Name="MaxItemsError" Style="{StaticResource Err}"
                             Text="Choose a number from 10 to 10,000."/>
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                  <DockPanel>
                    <TextBox x:Name="PreviewLinesBox" DockPanel.Dock="Right" Style="{DynamicResource Field}"
                             PreviewTextInput="OnNumberInput"/>
                    <StackPanel>
                      <TextBlock Text="Lines per clip" Style="{StaticResource Title}"/>
                      <TextBlock Text="1 to 100. Shown on the selected clip."
                                 Style="{StaticResource Desc}"/>
                    </StackPanel>
                  </DockPanel>
                  <TextBlock x:Name="PreviewLinesError" Style="{StaticResource Err}"
                             Text="Choose 1 to 100 lines."/>
                </StackPanel>

                <Grid Margin="0,12,0,0">
                  <DockPanel x:Name="ClearIdle">
                    <Button DockPanel.Dock="Right" Content="Clear history…" VerticalAlignment="Center"
                            Style="{StaticResource GhostSmall}" Click="OnClearClick"/>
                    <StackPanel>
                      <TextBlock Text="Clear history" Style="{StaticResource Title}"/>
                      <TextBlock Text="Removes clips from Clipboard and Images. Pinned clips stay."
                                 Style="{StaticResource Desc}"/>
                    </StackPanel>
                  </DockPanel>
                  <StackPanel x:Name="ClearConfirm" Visibility="Collapsed">
                    <TextBlock Text="Delete all clips in Clipboard and Images? Pinned clips and tabs stay."
                               Style="{StaticResource Note}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                      <Button Content="Keep clips" Style="{StaticResource GhostSmall}"
                              Click="OnKeepClick"/>
                      <Button Content="Delete clips" Style="{StaticResource PrimarySmall}"
                              Margin="8,0,0,0" Click="OnConfirmClearClick"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="APPEARANCE" Style="{StaticResource Sect}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme"
                                   Style="{StaticResource Seg}"/>
                      <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme"
                                   Style="{StaticResource Seg}"/>
                      <RadioButton x:Name="ThemeSystem" Content="Match Windows" GroupName="Theme"
                                   Style="{StaticResource Seg}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="Theme" Style="{StaticResource Title}"/>
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="Time24" Content="24-hour (14:30)" GroupName="Time"
                                   Style="{StaticResource Seg}"/>
                      <RadioButton x:Name="Time12" Content="12-hour (2:30 PM)" GroupName="Time"
                                   Style="{StaticResource Seg}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="Time format" Style="{StaticResource Title}"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="STARTUP" Style="{StaticResource Sect}"/>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <CheckBox x:Name="AutostartCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"/>
                <TextBlock Text="Open when I sign in" Style="{StaticResource Title}"/>
              </DockPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PanelNotification" Visibility="Collapsed">
            <TextBlock Text="NOTIFICATIONS" Style="{StaticResource Sect}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <CheckBox x:Name="NotifEnabled" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                            Checked="OnNotifChanged" Unchecked="OnNotifChanged"/>
                  <TextBlock Text="Notify me when I copy" Style="{StaticResource Title}"/>
                </DockPanel>

                <StackPanel Margin="0,12,0,0">
                  <DockPanel>
                    <TextBox x:Name="DurationBox" DockPanel.Dock="Right" Style="{DynamicResource Field}"
                             PreviewTextInput="OnNumberInput" TextChanged="OnNotifTextChanged"/>
                    <TextBlock Text="Time on screen (ms)" Style="{StaticResource Title}"/>
                  </DockPanel>
                  <TextBlock x:Name="DurationError" Style="{StaticResource Err}"
                             Text="Choose a number from 500 to 60,000."/>
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                  <DockPanel>
                    <TextBox x:Name="MaxLinesBox" DockPanel.Dock="Right" Style="{DynamicResource Field}"
                             PreviewTextInput="OnNumberInput" TextChanged="OnNotifTextChanged"/>
                    <TextBlock Text="Lines shown" Style="{StaticResource Title}"/>
                  </DockPanel>
                  <TextBlock x:Name="MaxLinesError" Style="{StaticResource Err}"
                             Text="Choose 1 to 10 lines."/>
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                  <DockPanel>
                    <TextBox x:Name="WidthBox" DockPanel.Dock="Right" Style="{DynamicResource Field}"
                             PreviewTextInput="OnNumberInput" TextChanged="OnNotifTextChanged"/>
                    <TextBlock Text="Width (px)" Style="{StaticResource Title}"/>
                  </DockPanel>
                  <TextBlock x:Name="WidthError" Style="{StaticResource Err}"
                             Text="Choose a width from 240 to 800."/>
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                  <DockPanel>
                    <TextBox x:Name="HeightBox" DockPanel.Dock="Right" Style="{DynamicResource Field}"
                             PreviewTextInput="OnNumberInput" TextChanged="OnNotifTextChanged"/>
                    <TextBlock Text="Height (px)" Style="{StaticResource Title}"/>
                  </DockPanel>
                  <TextBlock x:Name="HeightError" Style="{StaticResource Err}"
                             Text="Choose a height from 80 to 500."/>
                </StackPanel>

                <DockPanel Margin="0,12,0,0">
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="PosTopLeft" Content="Top left" GroupName="Position" Tag="top-left"
                                   Style="{StaticResource Seg}" Checked="OnNotifChanged"/>
                      <RadioButton x:Name="PosTopRight" Content="Top right" GroupName="Position" Tag="top-right"
                                   Style="{StaticResource Seg}" Checked="OnNotifChanged"/>
                      <RadioButton x:Name="PosBottomLeft" Content="Bottom left" GroupName="Position" Tag="bottom-left"
                                   Style="{StaticResource Seg}" Checked="OnNotifChanged"/>
                      <RadioButton x:Name="PosBottomRight" Content="Bottom right" GroupName="Position" Tag="bottom-right"
                                   Style="{StaticResource Seg}" Checked="OnNotifChanged"/>
                      <RadioButton x:Name="PosCenter" Content="Center" GroupName="Position" Tag="center"
                                   Style="{StaticResource Seg}" Checked="OnNotifChanged"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="Position" Style="{StaticResource Title}"/>
                </DockPanel>

                <StackPanel Margin="0,12,0,0">
                  <DockPanel>
                    <TextBox x:Name="OffsetXBox" DockPanel.Dock="Right" Style="{DynamicResource Field}"
                             Tag="signed" PreviewTextInput="OnNumberInput" TextChanged="OnNotifTextChanged"/>
                    <StackPanel>
                      <TextBlock Text="Horizontal offset" Style="{StaticResource Title}"/>
                      <TextBlock Text="Negative values move it left or up." Style="{StaticResource Desc}"/>
                    </StackPanel>
                  </DockPanel>
                  <TextBlock x:Name="OffsetXError" Style="{StaticResource Err}"
                             Text="Choose a number from -2,000 to 2,000."/>
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                  <DockPanel>
                    <TextBox x:Name="OffsetYBox" DockPanel.Dock="Right" Style="{DynamicResource Field}"
                             Tag="signed" PreviewTextInput="OnNumberInput" TextChanged="OnNotifTextChanged"/>
                    <TextBlock Text="Vertical offset" Style="{StaticResource Title}"/>
                  </DockPanel>
                  <TextBlock x:Name="OffsetYError" Style="{StaticResource Err}"
                             Text="Choose a number from -2,000 to 2,000."/>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="PREVIEW" Style="{StaticResource Sect}"/>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <ToggleButton x:Name="PreviewToggle" DockPanel.Dock="Right" Content="Show preview"
                              Style="{StaticResource Pin}" Checked="OnPreviewToggle"
                              Unchecked="OnPreviewToggle"/>
                <StackPanel>
                  <TextBlock Text="On-screen preview" Style="{StaticResource Title}"/>
                  <TextBlock Text="Shows where the notification will appear. Drag it to set the offsets."
                             Style="{StaticResource Desc}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
              Padding="20,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource Ghost}" Click="OnCloseClick"
                  ToolTip="Cancel (Esc)" AutomationProperties.Name="Cancel (Esc)"/>
          <Button Content="Save changes" Style="{StaticResource Primary}" Margin="8,0,0,0"
                  Click="OnSaveClick" ToolTip="Save changes (Ctrl+S)"
                  AutomationProperties.Name="Save changes (Ctrl+S)"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
