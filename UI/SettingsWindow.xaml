<Window x:Class="Clip.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- No error token exists in the theme dictionaries; one red shared by both themes. -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B"/>

    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Margin" Value="2,0,0,3"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="2,2,0,8"/>
    </Style>

    <Style x:Key="Row" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Chk" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="15" Height="15" CornerRadius="4"
                      BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                      Background="Transparent" VerticalAlignment="Center">
                <TextBlock x:Name="Tick" Text="✓" FontSize="10"
                           Foreground="{StaticResource Surface}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Combo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid Background="Transparent">
              <ToggleButton Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="▾" FontSize="10" Margin="6,0,0,0"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"/>
              </ToggleButton>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="4"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0">
                  <ItemsPresenter/>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{StaticResource Raised}" CornerRadius="8"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="8"
                    BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource Surface}" CornerRadius="14"
          BorderBrush="{StaticResource Hairline}" BorderThickness="1"
          MouseLeftButtonDown="OnDrag">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
    </Border.Effect>

    <Grid Margin="16" TextElement.FontFamily="{StaticResource UiFont}"
          TextElement.Foreground="{StaticResource Fg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Settings" FontSize="15" FontWeight="Bold"
                 Margin="2,0,2,8"/>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
        <StackPanel>

          <!-- Hotkey -->
          <TextBlock Text="Hotkey" Style="{StaticResource H}"/>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Open popup" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="HotkeyBox" Grid.Column="1" Style="{StaticResource Field}"
                       Width="150" TextAlignment="Right" FontWeight="SemiBold"
                       IsReadOnly="True" IsReadOnlyCaretVisible="False"
                       PreviewKeyDown="OnHotkeyKeyDown"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Paste as plain text" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="PlainHotkeyBox" Grid.Column="1" Style="{StaticResource Field}"
                       Width="150" TextAlignment="Right" FontWeight="SemiBold"
                       IsReadOnly="True" IsReadOnlyCaretVisible="False"
                       PreviewKeyDown="OnHotkeyKeyDown"/>
            </Grid>
          </Border>
          <TextBlock Text="Click a box, then press a new combination." Style="{StaticResource Hint}"/>
          <TextBlock x:Name="HotkeyError" Visibility="Collapsed"
                     Foreground="{StaticResource ErrorBrush}" FontSize="11"
                     TextWrapping="Wrap" Margin="2,-6,0,10"/>

          <!-- Max items -->
          <TextBlock Text="Max items" Style="{StaticResource H}"/>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Items kept in history" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="MaxItemsBox" Grid.Column="1" Style="{StaticResource Field}"
                       Width="90" TextAlignment="Right" PreviewTextInput="OnNumberInput"/>
            </Grid>
          </Border>
          <TextBlock x:Name="MaxItemsError" Visibility="Collapsed"
                     Text="Enter a whole number between 10 and 10,000."
                     Foreground="{StaticResource ErrorBrush}" FontSize="11"
                     TextWrapping="Wrap" Margin="2,-2,0,10"/>

          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Preview lines" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="PreviewLinesBox" Grid.Column="1" Style="{StaticResource Field}"
                       Width="90" TextAlignment="Right" PreviewTextInput="OnNumberInput"/>
            </Grid>
          </Border>
          <TextBlock Text="Lines shown per clip card in the popup" Style="{StaticResource Hint}"
                     Margin="2,0,0,4"/>
          <TextBlock x:Name="PreviewLinesError" Visibility="Collapsed"
                     Text="Enter a whole number between 1 and 100."
                     Foreground="{StaticResource ErrorBrush}" FontSize="11"
                     TextWrapping="Wrap" Margin="2,-2,0,10"/>

          <!-- Notification -->
          <TextBlock Text="Notification" Style="{StaticResource H}"/>
          <Border Style="{StaticResource Row}">
            <CheckBox x:Name="NotifEnabled" Style="{StaticResource Chk}"
                      Content="Show a notification when something is copied"/>
          </Border>

          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Duration (ms)" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="DurationBox" Grid.Column="1" Style="{StaticResource Field}"
                       TextAlignment="Right" Margin="8,0,0,0" PreviewTextInput="OnNumberInput"/>
              <TextBlock Grid.Column="3" Text="Max lines" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="MaxLinesBox" Grid.Column="4" Style="{StaticResource Field}"
                       TextAlignment="Right" Margin="8,0,0,0" PreviewTextInput="OnNumberInput"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Width (px)" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="WidthBox" Grid.Column="1" Style="{StaticResource Field}"
                       TextAlignment="Right" Margin="8,0,0,0" PreviewTextInput="OnNumberInput"/>
              <TextBlock Grid.Column="3" Text="Height (px)" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="HeightBox" Grid.Column="4" Style="{StaticResource Field}"
                       TextAlignment="Right" Margin="8,0,0,0" PreviewTextInput="OnNumberInput"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Position" FontSize="12" VerticalAlignment="Center"/>
              <ComboBox x:Name="PositionCombo" Grid.Column="1" Style="{StaticResource Combo}" Width="140">
                <ComboBoxItem Content="Top left" Tag="top-left"/>
                <ComboBoxItem Content="Top right" Tag="top-right"/>
                <ComboBoxItem Content="Bottom left" Tag="bottom-left"/>
                <ComboBoxItem Content="Bottom right" Tag="bottom-right"/>
                <ComboBoxItem Content="Center" Tag="center"/>
              </ComboBox>
            </Grid>
          </Border>

          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Offset X" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="OffsetXBox" Grid.Column="1" Style="{StaticResource Field}"
                       Tag="signed" TextAlignment="Right" Margin="8,0,0,0" PreviewTextInput="OnNumberInput"/>
              <TextBlock Grid.Column="3" Text="Offset Y" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="OffsetYBox" Grid.Column="4" Style="{StaticResource Field}"
                       Tag="signed" TextAlignment="Right" Margin="8,0,0,0" PreviewTextInput="OnNumberInput"/>
            </Grid>
          </Border>

          <!-- Theme -->
          <TextBlock Text="Theme" Style="{StaticResource H}"/>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Appearance" FontSize="12" VerticalAlignment="Center"/>
              <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{StaticResource Combo}" Width="140">
                <ComboBoxItem Content="Dark" Tag="dark"/>
                <ComboBoxItem Content="Light" Tag="light"/>
                <ComboBoxItem Content="System" Tag="system"/>
              </ComboBox>
            </Grid>
          </Border>

          <!-- Time format -->
          <TextBlock Text="Time format" Style="{StaticResource H}"/>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Clock" FontSize="12" VerticalAlignment="Center"/>
              <ComboBox x:Name="TimeCombo" Grid.Column="1" Style="{StaticResource Combo}" Width="140">
                <ComboBoxItem Content="24 hour" Tag="24h"/>
                <ComboBoxItem Content="12 hour" Tag="12h"/>
              </ComboBox>
            </Grid>
          </Border>

          <!-- Start on login -->
          <TextBlock Text="Start on login" Style="{StaticResource H}"/>
          <Border Style="{StaticResource Row}">
            <CheckBox x:Name="AutostartCheck" Style="{StaticResource Chk}"
                      Content="Launch when Windows starts"/>
          </Border>

          <!-- Clear history -->
          <TextBlock Text="Clear history" Style="{StaticResource H}"/>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid x:Name="ClearIdle">
                <TextBlock Text="Clipboard history" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Clear" Style="{StaticResource BtnGhost}" Padding="10,3"
                        HorizontalAlignment="Right" Click="OnClearClick"/>
              </Grid>
              <StackPanel x:Name="ClearConfirm" Visibility="Collapsed">
                <TextBlock Text="Delete every saved clip? This cannot be undone."
                           FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                  <Button Content="Clear" Style="{StaticResource Btn}" Padding="12,4"
                          Click="OnConfirmClearClick"/>
                  <Button Content="Keep" Style="{StaticResource BtnGhost}" Padding="12,4"
                          Margin="6,0,0,0" Click="OnKeepClick"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Ctrl+S to save   ·   Esc to close"
                   Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Close" Style="{StaticResource BtnGhost}" Click="OnCloseClick"/>
        <Button Grid.Column="2" Content="Save" Style="{StaticResource Btn}" Margin="8,0,0,0"
                Click="OnSaveClick"/>
      </Grid>
    </Grid>
  </Border>
</Window>
