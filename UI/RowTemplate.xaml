<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Clip.UI">

  <BooleanToVisibilityConverter x:Key="BoolToVis"/>

  <!-- Flat container: the row's own Border draws every state. -->
  <Style x:Key="ClipRowItem" TargetType="ListBoxItem">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Row anatomy v2 (docs\DESIGN-v2-ui.md §1.3): content-only, height from ClipRow, selection is
    tint + ring + rail only. No element below changes size, margin or visibility on selection.
  -->
  <DataTemplate x:Key="ClipRowTemplate">
    <StackPanel x:Name="ItemRoot" Background="Transparent">
      <StackPanel.RenderTransform>
        <TranslateTransform/>
      </StackPanel.RenderTransform>

      <Grid x:Name="SectionBand" Margin="2,0,10,10" Visibility="{Binding ShowSection, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding SectionLabel}" FontSize="10" LineHeight="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource Fg48}"/>
        <Border Grid.Column="1" Height="1" Margin="8,0,0,0" VerticalAlignment="Center"
                Background="{DynamicResource Divider}"/>
      </Grid>

      <!-- Full-bleed zebra band: the rounded 12 radius stays on the state layers, so an odd-row fill
           never leaves a scalloped notch at the row boundary. -->
      <Border x:Name="RowRoot" Background="Transparent" CornerRadius="0"
              Height="{Binding RowHeight}">
        <Grid>
          <!-- Forest zebra (docs\RESEARCH-clipboardapps\copyq-forest.md §4): fill, hairline, then states over it. -->
          <Border x:Name="RowDivider" Height="1" VerticalAlignment="Bottom"
                  Background="{DynamicResource Divider}" IsHitTestVisible="False"/>
          <Border x:Name="HoverLayer" Background="{DynamicResource RowHover}" CornerRadius="12"
                  Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="SelLayer" Background="{DynamicResource RowSelected}" CornerRadius="12"
                  Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="Ring" BorderBrush="{DynamicResource SelectionRing}" BorderThickness="1"
                  CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="Rail" Width="2" Height="24" CornerRadius="1"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"
                  Background="{DynamicResource SelectionRail}" Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="PulseLayer" Background="{DynamicResource PulseFill}"
                  BorderBrush="{DynamicResource PulseRing}" BorderThickness="1"
                  CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>

          <Grid Margin="2,10,10,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The gutter: 1..N of the visible list in a code-chip box; 10+ are labels only. -->
            <Border Grid.Column="0" MinWidth="26" Height="20" Padding="6,0" Margin="0,1,0,0"
                    CornerRadius="6" VerticalAlignment="Top"
                    Background="{DynamicResource BadgeBackground}">
              <TextBlock x:Name="NumberText" Text="{Binding Number}"
                         FontFamily="{StaticResource MonoFont}" FontSize="10" LineHeight="14"
                         FontWeight="Normal" TextAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Fg48}"/>
            </Border>

            <TextBlock x:Name="Body" Grid.Column="2" Height="{Binding TextHeight}"
                       FontFamily="{StaticResource UiFont}" FontSize="14" LineHeight="20" FontWeight="Normal"
                       Foreground="{DynamicResource Fg}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       LineStackingStrategy="BlockLineHeight" ClipToBounds="True"
                       ui:RowContent.Row="{Binding}" ui:RowContent.Query="{Binding Query}"/>

            <Border x:Name="Badge" Grid.Column="3" Height="22" Padding="8,0" CornerRadius="11"
                    Margin="10,0,0,0" VerticalAlignment="Top"
                    Background="{DynamicResource BadgeBackground}"
                    Visibility="{Binding MoreVisibility}">
              <TextBlock Text="{Binding More}" FontSize="10" LineHeight="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource Fg55}" VerticalAlignment="Center"
                         Typography.NumeralAlignment="Tabular"/>
            </Border>

            <!-- Owner request: provenance under every clip — app · date time · window title,
                 set off from the body by a hairline. ClipRow.RowHeight reserves this block
                 so selection still moves no geometry. -->
            <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Height="1" Margin="0,8,0,0"
                    Background="{DynamicResource Divider}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                       Text="{Binding Item.Meta}" Height="18" Margin="0,6,0,0"
                       FontSize="10" LineHeight="16" Foreground="{DynamicResource Fg48}"
                       TextTrimming="CharacterEllipsis"
                       Typography.NumeralAlignment="Tabular"/>
          </Grid>
        </Grid>
      </Border>
    </StackPanel>

    <DataTemplate.Triggers>
      <!-- Odd rows take RowAlt. Parity comes from the generator's AlternationIndex, so it survives
           container recycling and renumbers itself after every filter. -->
      <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                   Value="1">
        <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource RowAlt}"/>
      </DataTrigger>

      <!-- Hover: one 100 ms opacity step, brush only. -->
      <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>

      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="SelLayer" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.100"/>
              <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.100"/>
              <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="SelLayer" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.100"/>
              <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.100"/>
              <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
        <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource Fg55}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!--
    Images tab (docs\DESIGN-v2-ui.md §3.2): the same ListBox in a horizontal, virtualising panel.
    4 tiles + a peek at 550 px. ClipListPanel is the text list's own panel, re-applied on the way out.
  -->
  <ItemsPanelTemplate x:Key="ImageStripPanel">
    <VirtualizingStackPanel Orientation="Horizontal"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Item"
                            VirtualizingPanel.CacheLength="2,2"/>
  </ItemsPanelTemplate>

  <ItemsPanelTemplate x:Key="ClipListPanel">
    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Item"
                            VirtualizingPanel.CacheLength="1,1"/>
  </ItemsPanelTemplate>

  <!--
    One image tile. Fit never crop (synthesis Q6): Stretch=Uniform, never UniformToFill. The thumb is
    the stored 96 px PNG decoded once per row; selection and hover change brushes only, 100 ms.
  -->
  <DataTemplate x:Key="ImageTileTemplate">
    <Border x:Name="Tile" Width="120" Height="120" Margin="0,0,10,0" CornerRadius="10"
            Background="{DynamicResource Field}" ClipToBounds="True">
      <Grid>
        <Grid Margin="5">
          <Image Source="{Binding Thumb}" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <!-- A tile that cannot decode says so: a blank grey box is not a state (AUDIT-s3-visual P1-3). -->
          <StackPanel x:Name="NoThumb" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox Width="22" Height="22">
              <Path Data="{DynamicResource IconPicture}" Stroke="{DynamicResource Fg40}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
            <TextBlock Text="No preview" FontSize="10" LineHeight="16" Foreground="{DynamicResource Fg48}"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>

        <Border x:Name="HoverRing" BorderBrush="{DynamicResource ControlLine}" BorderThickness="1"
                CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
        <Border x:Name="SelRing" BorderBrush="{DynamicResource AccentText}" BorderThickness="1"
                CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>

        <!-- The number is the Ctrl+1..9 affordance; an opaque pill reads over any image (§1.4). -->
        <Border Height="20" Padding="5,0" CornerRadius="5" Background="{DynamicResource App}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" IsHitTestVisible="False">
          <TextBlock Text="{Binding Number}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                     LineHeight="14" FontWeight="Normal"
                     Foreground="{DynamicResource Fg75}" VerticalAlignment="Center"/>
        </Border>
      </Grid>
    </Border>

    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Thumb}" Value="{x:Null}">
        <Setter TargetName="NoThumb" Property="Visibility" Value="Visible"/>
      </DataTrigger>

      <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>

      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="SelRing" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="SelRing" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
