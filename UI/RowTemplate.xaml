<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Clip.UI">

  <BooleanToVisibilityConverter x:Key="BoolToVis"/>

  <!-- Flat container: the row's own Border draws every state. -->
  <Style x:Key="ClipRowItem" TargetType="ListBoxItem">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Row anatomy v2 (docs\DESIGN-v2-ui.md §1.3): content-only, height from ClipRow, selection is
    tint + ring + rail only. No element below changes size, margin or visibility on selection.
  -->
  <DataTemplate x:Key="ClipRowTemplate">
    <StackPanel x:Name="ItemRoot" Background="Transparent">
      <StackPanel.RenderTransform>
        <TranslateTransform/>
      </StackPanel.RenderTransform>

      <Grid x:Name="SectionBand" Margin="12,0,12,8" Visibility="{Binding ShowSection, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding SectionLabel}" FontSize="10" LineHeight="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource Fg48}"/>
        <Border Grid.Column="1" Height="1" Margin="8,0,0,0" VerticalAlignment="Center"
                Background="{DynamicResource Divider}"/>
      </Grid>

      <Border x:Name="RowRoot" Background="Transparent" CornerRadius="12"
              Height="{Binding RowHeight}" ToolTipService.InitialShowDelay="600"
              ToolTipService.IsEnabled="{Binding HasTooltip}">
        <Border.ToolTip>
          <TextBlock Text="{Binding Tooltip}" TextWrapping="Wrap" MaxWidth="420"
                     FontFamily="Segoe UI" FontSize="12" LineHeight="18"/>
        </Border.ToolTip>

        <Grid>
          <Border x:Name="HoverLayer" Background="{DynamicResource RowHover}" CornerRadius="12"
                  Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="SelLayer" Background="{DynamicResource RowSelected}" CornerRadius="12"
                  Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="Ring" BorderBrush="{DynamicResource SelectionRing}" BorderThickness="1"
                  CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="Rail" Width="2" Height="24" CornerRadius="1"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"
                  Background="{DynamicResource SelectionRail}" Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="PulseLayer" Background="{DynamicResource PulseFill}"
                  BorderBrush="{DynamicResource PulseRing}" BorderThickness="1"
                  CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>

          <Grid Margin="12,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- The gutter: 1..N of the visible list, right-aligned at x = 40; 10+ are labels only. -->
            <TextBlock x:Name="NumberText" Grid.Column="0" Text="{Binding Number}"
                       Width="22" Height="18" VerticalAlignment="Top"
                       FontSize="11" LineHeight="18" FontWeight="SemiBold" TextAlignment="Right"
                       Foreground="{DynamicResource Fg55}" Typography.NumeralAlignment="Tabular"/>

            <TextBlock x:Name="Body" Grid.Column="2" Height="{Binding TextHeight}"
                       FontFamily="Segoe UI" FontSize="13" LineHeight="18" FontWeight="Normal"
                       Foreground="{DynamicResource Fg55}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       LineStackingStrategy="BlockLineHeight" ClipToBounds="True"
                       ui:RowContent.Row="{Binding}" ui:RowContent.Query="{Binding Query}"/>

            <Border x:Name="Badge" Grid.Column="3" Height="18" Padding="6,0" CornerRadius="9"
                    Margin="8,0,0,0" VerticalAlignment="Top"
                    Background="{DynamicResource BadgeBackground}"
                    Visibility="{Binding MoreVisibility}" ToolTip="{Binding MoreTip}"
                    ToolTipService.InitialShowDelay="600">
              <TextBlock Text="{Binding More}" FontSize="11" LineHeight="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Fg55}" VerticalAlignment="Center"
                         Typography.NumeralAlignment="Tabular"/>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </StackPanel>

    <DataTemplate.Triggers>
      <!-- Hover: one 100 ms opacity step, brush only. -->
      <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>

      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="SelLayer" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.100"/>
              <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.100"/>
              <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="SelLayer" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.100"/>
              <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.100"/>
              <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.100"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
        <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Fg75}"/>
        <Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource Fg75}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
