<Window x:Class="Clip.UI.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit clip" Width="560" Height="496"
        WindowStyle="None" Background="{DynamicResource App}"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        >

  <Window.Resources>
    <!-- Stock WPF templates paint Windows-blue focus borders and white scrollbars on a dark
         surface. This one replaces them with tokens; ScrollBar is vertical-only because the
         editor disables horizontal scrolling. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Width="6" Margin="2,0">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EditorRichField" TargetType="RichTextBox">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
      <Setter Property="Background" Value="{DynamicResource Field}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RichTextBox">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Toolbar controls: checked = Surface fill + 1px accent line, so an "on" button is
         never Windows blue. -->
    <Style x:Key="ToolToggle" TargetType="ToggleButton">
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface}"/>
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Divider}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{DynamicResource ControlLine}" BorderThickness="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Fg}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource Divider}"/>
    </Style>

    <Style x:Key="FooterButton" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.86"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" Background="{DynamicResource App}" CornerRadius="8"
          BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Opacity="0">

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="56"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="18,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock Text="Edit clip" FontSize="13" LineHeight="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
          <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24"
                  Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnCancelClick"
                  ToolTip="Cancel (Esc)" AutomationProperties.Name="Cancel">
            <Viewbox Width="10" Height="10">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Fg48}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <!-- Formatting toolbar: every button acts on the selection and reflects the caret. -->
      <Border Grid.Row="1" Padding="18,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ToggleButton x:Name="BoldButton" Style="{StaticResource ToolToggle}" Click="OnBoldClick"
                        ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold">
            <TextBlock Text="B" FontSize="13" FontWeight="Bold"/>
          </ToggleButton>
          <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToolToggle}" Click="OnItalicClick"
                        ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic">
            <!-- Segoe/Manrope italic I is a bare slash; a serif I stays recognisable next to U. -->
            <TextBlock Text="I" FontFamily="Georgia" FontSize="14" FontStyle="Italic"/>
          </ToggleButton>
          <ToggleButton x:Name="UnderlineButton" Style="{StaticResource ToolToggle}" Click="OnUnderlineClick"
                        ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline">
            <TextBlock Text="U" FontSize="13" TextDecorations="Underline"/>
          </ToggleButton>
          <ToggleButton x:Name="StrikeButton" Style="{StaticResource ToolToggle}" Click="OnStrikeClick"
                        ToolTip="Strikethrough" AutomationProperties.Name="Strikethrough">
            <TextBlock Text="S" FontSize="13" TextDecorations="Strikethrough"/>
          </ToggleButton>

          <Border Style="{StaticResource ToolSeparator}"/>

          <Button x:Name="SmallerButton" Style="{StaticResource ToolButton}" Content="A−"
                  ToolTip="Smaller text" AutomationProperties.Name="Smaller text" Click="OnSmallerClick"/>
          <TextBlock x:Name="SizeText" Text="13" Width="24" TextAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Fg75}" VerticalAlignment="Center"
                     AutomationProperties.Name="Font size"/>
          <Button x:Name="LargerButton" Style="{StaticResource ToolButton}" Content="A+"
                  ToolTip="Larger text" AutomationProperties.Name="Larger text" Click="OnLargerClick"/>

          <Border Style="{StaticResource ToolSeparator}"/>

          <Button x:Name="ColorButton" Style="{StaticResource ToolButton}" Click="OnColorButtonClick"
                  ToolTip="Text colour" AutomationProperties.Name="Text colour">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="A" FontSize="12" HorizontalAlignment="Center"/>
              <Border x:Name="ColorBar" Height="4" Width="14" CornerRadius="1" Margin="0,1,0,0"
                      Background="{DynamicResource AccentText}" BorderBrush="{DynamicResource ControlLine}"
                      BorderThickness="1"/>
            </StackPanel>
          </Button>
          <Button x:Name="MarkButton" Style="{StaticResource ToolButton}" Click="OnMarkButtonClick"
                  ToolTip="Highlight" AutomationProperties.Name="Highlight">
            <Grid Width="14" Height="14">
              <Border x:Name="MarkChip" CornerRadius="3" Background="Transparent"
                      BorderBrush="{DynamicResource ControlLine}" BorderThickness="1"/>
              <Path x:Name="MarkSlash" Data="M3.5,10.5 L10.5,3.5" Stroke="{DynamicResource Fg48}"
                    StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    IsHitTestVisible="False"/>
            </Grid>
          </Button>
          <Button x:Name="ClearButton" Style="{StaticResource ToolButton}" Content="Clear" Padding="8,0"
                  ToolTip="Clear formatting" AutomationProperties.Name="Clear formatting" Click="OnClearClick"/>

          <Popup x:Name="ColorPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=ColorButton}"
                 VerticalOffset="4">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Fg}" Tag="Fg"
                        ToolTip="White" AutomationProperties.Name="White text" Click="OnTextColorSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Fg75}" Tag="Fg75"
                        ToolTip="Light grey" AutomationProperties.Name="Light grey text" Click="OnTextColorSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource AccentText}" Tag="AccentText"
                        ToolTip="Orange" AutomationProperties.Name="Orange text" Click="OnTextColorSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource ControlLine}" Tag="ControlLine"
                        ToolTip="Muted grey" AutomationProperties.Name="Muted grey text" Click="OnTextColorSwatch"/>
              </StackPanel>
            </Border>
          </Popup>

          <Popup x:Name="MarkPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=MarkButton}"
                 VerticalOffset="4">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Swatch}" Background="Transparent" Tag="none"
                        ToolTip="No highlight" AutomationProperties.Name="No highlight" Click="OnMarkSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Amber}" Tag="Amber"
                        ToolTip="Amber highlight" AutomationProperties.Name="Amber highlight" Click="OnMarkSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Sage}" Tag="Sage"
                        ToolTip="Sage highlight" AutomationProperties.Name="Sage highlight" Click="OnMarkSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Sky}" Tag="Sky"
                        ToolTip="Sky highlight" AutomationProperties.Name="Sky highlight" Click="OnMarkSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Violet}" Tag="Violet"
                        ToolTip="Violet highlight" AutomationProperties.Name="Violet highlight" Click="OnMarkSwatch"/>
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </Border>

      <!-- Only shown when the body could not be loaded; never a silent plain fallback. -->
      <Border x:Name="FormatNotice" Grid.Row="2" Visibility="Collapsed" Margin="18,10,18,0"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
              BorderThickness="1" CornerRadius="8" Padding="10,7"
              AutomationProperties.Name="Formatting not loaded">
        <TextBlock x:Name="FormatNoticeText" FontSize="12" LineHeight="17"
                   Foreground="{DynamicResource Fg75}" TextWrapping="Wrap"
                   Text="This clip's formatting could not be loaded; editing as plain text."/>
      </Border>

      <Grid Grid.Row="3" Margin="18,14">
        <RichTextBox x:Name="RichBox" Style="{StaticResource EditorRichField}" FontFamily="Segoe UI"
                     VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged" TextChanged="OnTextChanged"
                     AutomationProperties.Name="Clip content"/>

        <Border x:Name="DiscardPrompt" Visibility="Collapsed" VerticalAlignment="Bottom"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}"
                BorderThickness="1" CornerRadius="10" Padding="14" Panel.ZIndex="10">
          <StackPanel>
            <TextBlock x:Name="DiscardText" Text="Discard changes?" FontSize="13" LineHeight="18"
                       FontWeight="Medium" Foreground="{DynamicResource Fg75}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
              <Button x:Name="KeepEditing" Content="Keep editing" Style="{StaticResource FooterButton}"
                      Background="Transparent" Foreground="{DynamicResource Fg55}"
                      BorderBrush="{DynamicResource ControlLine}" BorderThickness="1"
                      Click="OnKeepEditingClick"/>
              <Button Content="Discard" Style="{StaticResource FooterButton}" Margin="8,0,0,0"
                      Background="Transparent" Foreground="{DynamicResource Error}"
                      BorderBrush="{DynamicResource Error}" BorderThickness="1"
                      Click="OnDiscardClick"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="4" Padding="18,12" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
        <Grid>
          <TextBlock Text="Ctrl+S saves" FontSize="11" LineHeight="16" Foreground="{DynamicResource Fg48}"
                     VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource FooterButton}" Background="Transparent"
                    Foreground="{DynamicResource Fg55}" BorderBrush="{DynamicResource ControlLine}"
                    BorderThickness="1" Click="OnCancelClick" ToolTip="Cancel (Esc)"/>
            <Button x:Name="SaveButton" Content="Save changes" Style="{StaticResource FooterButton}" Margin="8,0,0,0"
                    Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"
                    Click="OnSaveClick" ToolTip="Save changes (Ctrl+S)"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
