<Window x:Class="Clip.UI.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Edit clip" Width="640" Height="600"
        WindowStyle="None" Background="{DynamicResource App}"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource FontBodySize}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        >

  <Window.Resources>
    <!-- LAYER B surface: the clip's own content sits on Surface, framed by ControlLine. -->
    <Style x:Key="EditorField" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- Toolbar controls come from the shared button grammar (UI\Themes\Buttons.xaml). -->
    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{DynamicResource ControlLine}" BorderThickness="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource Divider}"/>
    </Style>

    <!-- DESIGN-language Keycap: 11 Mono SemiBold on KeycapBackground, right-aligned key hints. -->
    <Style x:Key="Keycap" TargetType="Border">
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource KeycapBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource KeycapLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KeycapText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontKeycapSize}"/>
      <Setter Property="LineHeight" Value="{DynamicResource FontKeycapLine}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" Background="{DynamicResource App}" CornerRadius="12"
          BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Opacity="0">

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="20,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock Text="Edit clip" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" FontWeight="SemiBold"
                     Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
          <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                  Click="OnCancelClick"
                  ToolTip="Cancel (Esc)" AutomationProperties.Name="Cancel">
            <Viewbox Width="12" Height="12">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Fg48}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <!-- Formatting toolbar: every button acts on the selection and reflects the caret. -->
      <Border Grid.Row="1" Padding="8,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ToggleButton x:Name="BoldButton" Style="{StaticResource ToolToggle}" Click="OnBoldClick" Margin="0,0,4,0"
                        ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold">
            <TextBlock Text="B" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" LineStackingStrategy="BlockLineHeight" FontWeight="Bold"/>
          </ToggleButton>
          <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToolToggle}" Click="OnItalicClick" Margin="0,0,4,0"
                        ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic">
            <!-- Segoe/Manrope italic I is a bare slash; a serif I stays recognisable next to U. -->
            <TextBlock Text="I" FontFamily="Georgia" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" LineStackingStrategy="BlockLineHeight" FontStyle="Italic"/>
          </ToggleButton>
          <ToggleButton x:Name="UnderlineButton" Style="{StaticResource ToolToggle}" Click="OnUnderlineClick" Margin="0,0,4,0"
                        ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline">
            <TextBlock Text="U" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" LineStackingStrategy="BlockLineHeight" TextDecorations="Underline"/>
          </ToggleButton>
          <ToggleButton x:Name="StrikeButton" Style="{StaticResource ToolToggle}" Click="OnStrikeClick" Margin="0,0,4,0"
                        ToolTip="Strikethrough" AutomationProperties.Name="Strikethrough">
            <TextBlock Text="S" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" LineStackingStrategy="BlockLineHeight" TextDecorations="Strikethrough"/>
          </ToggleButton>

          <Border Style="{StaticResource ToolSeparator}"/>

          <Button x:Name="SmallerButton" Style="{StaticResource ToolButton}" Click="OnSmallerClick"
                  ToolTip="Smaller text" AutomationProperties.Name="Smaller text">
            <TextBlock Text="A−" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" LineStackingStrategy="BlockLineHeight"/>
          </Button>
          <TextBlock x:Name="SizeText" Text="16" Width="28" TextAlignment="Center" FontSize="{DynamicResource FontBodySize}"
                     LineHeight="{DynamicResource FontBodyLine}" LineStackingStrategy="BlockLineHeight"
                     Foreground="{DynamicResource Fg75}" VerticalAlignment="Center"
                     AutomationProperties.Name="Font size"/>
          <Button x:Name="LargerButton" Style="{StaticResource ToolButton}" Click="OnLargerClick"
                  ToolTip="Larger text" AutomationProperties.Name="Larger text">
            <TextBlock Text="A+" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" LineStackingStrategy="BlockLineHeight"/>
          </Button>

          <Border Style="{StaticResource ToolSeparator}"/>

          <Button x:Name="ColorButton" Style="{StaticResource ToolButton}" Click="OnColorButtonClick" Margin="0,0,4,0"
                  ToolTip="Text colour" AutomationProperties.Name="Text colour">
            <!-- One 20 px line block, same as every other glyph, so the letter baseline aligns;
                 the swatch bar parks in the descent zone below it. -->
            <Grid Height="20">
              <TextBlock Text="A" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}" LineStackingStrategy="BlockLineHeight"
                         VerticalAlignment="Top" HorizontalAlignment="Center"/>
              <Border x:Name="ColorBar" Height="3" Width="14" CornerRadius="1.5" Margin="0,0,0,1"
                      VerticalAlignment="Bottom" Background="{DynamicResource AccentText}"/>
            </Grid>
          </Button>
          <Button x:Name="MarkButton" Style="{StaticResource ToolButton}" Click="OnMarkButtonClick" Margin="0,0,4,0"
                  ToolTip="Highlight" AutomationProperties.Name="Highlight">
            <Grid Height="20">
              <TextBlock Text="ab" FontSize="{DynamicResource FontBodySize}" FontWeight="SemiBold" LineHeight="{DynamicResource FontBodyLine}"
                         LineStackingStrategy="BlockLineHeight"
                         VerticalAlignment="Top" HorizontalAlignment="Center"/>
              <Border x:Name="MarkChip" Height="3" Width="14" CornerRadius="1.5" Margin="0,0,0,1"
                      VerticalAlignment="Bottom" Background="Transparent"/>
            </Grid>
          </Button>
          <Button x:Name="ClearButton" Style="{StaticResource ToolButton}" Click="OnClearClick"
                  ToolTip="Clear formatting" AutomationProperties.Name="Clear formatting" Padding="10,0">
            <TextBlock Text="Clear" FontSize="{DynamicResource FontCaptionSize}" FontWeight="Medium" LineHeight="{DynamicResource FontCaptionLine}" LineStackingStrategy="BlockLineHeight"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Click="OnSingleLineClick" Margin="4,0,0,0"
                  ToolTip="Join into one line (remove line breaks)" AutomationProperties.Name="Single line" Padding="10,0">
            <TextBlock Text="Single line" FontSize="{DynamicResource FontCaptionSize}" FontWeight="Medium" LineHeight="{DynamicResource FontCaptionLine}" LineStackingStrategy="BlockLineHeight"/>
          </Button>
          <Button Style="{StaticResource ToolButton}" Click="OnCaseClick" Margin="4,0,0,0"
                  ToolTip="Change case: lowercase / UPPERCASE / Title Case" AutomationProperties.Name="Change case" Padding="10,0">
            <TextBlock Text="Aa" FontSize="{DynamicResource FontBodySize}" FontWeight="SemiBold" LineHeight="{DynamicResource FontBodyLine}" LineStackingStrategy="BlockLineHeight"/>
          </Button>

          <Popup x:Name="ColorPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=ColorButton}"
                 VerticalOffset="4">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Fg}" Tag="Fg"
                        ToolTip="Ink" AutomationProperties.Name="Ink text" Click="OnTextColorSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Fg75}" Tag="Fg75"
                        ToolTip="Secondary" AutomationProperties.Name="Secondary text" Click="OnTextColorSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource AccentText}" Tag="AccentText"
                        ToolTip="Accent" AutomationProperties.Name="Accent text" Click="OnTextColorSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource ControlLine}" Tag="ControlLine"
                        ToolTip="Muted grey" AutomationProperties.Name="Muted grey text" Click="OnTextColorSwatch"/>
              </StackPanel>
            </Border>
          </Popup>

          <Popup x:Name="MarkPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=MarkButton}"
                 VerticalOffset="4">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Swatch}" Background="Transparent" Tag="none"
                        ToolTip="No highlight" AutomationProperties.Name="No highlight" Click="OnMarkSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Amber}" Tag="Amber"
                        ToolTip="Amber highlight" AutomationProperties.Name="Amber highlight" Click="OnMarkSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Sage}" Tag="Sage"
                        ToolTip="Sage highlight" AutomationProperties.Name="Sage highlight" Click="OnMarkSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Sky}" Tag="Sky"
                        ToolTip="Sky highlight" AutomationProperties.Name="Sky highlight" Click="OnMarkSwatch"/>
                <Button Style="{StaticResource Swatch}" Background="{DynamicResource Violet}" Tag="Violet"
                        ToolTip="Violet highlight" AutomationProperties.Name="Violet highlight" Click="OnMarkSwatch"/>
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </Border>

      <!-- Only shown when the body could not be loaded; never a silent plain fallback. -->
      <Border x:Name="FormatNotice" Grid.Row="2" Visibility="Collapsed" Margin="8,6,8,0"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
              BorderThickness="1" CornerRadius="8" Padding="10,7"
              AutomationProperties.Name="Formatting not loaded">
        <TextBlock x:Name="FormatNoticeText" FontSize="{DynamicResource FontCaptionSize}" LineHeight="{DynamicResource FontCaptionLine}"
                   Foreground="{DynamicResource Fg75}" TextWrapping="Wrap"
                   Text="This clip's formatting could not be loaded; editing as plain text."/>
      </Border>

      <!-- The discard prompt is a banner, not a floating card: WPF cannot draw over the WebView's
           child window, and hiding the browser would blank the clip the question is about. -->
      <Border x:Name="DiscardPrompt" Grid.Row="3" Visibility="Collapsed" Margin="8,6,8,0"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}"
              BorderThickness="1" CornerRadius="12" Padding="14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DiscardText" Text="Discard changes?" FontSize="{DynamicResource FontBodySize}" LineHeight="{DynamicResource FontBodyLine}"
                     FontWeight="Medium" Foreground="{DynamicResource Fg75}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button x:Name="KeepEditing" Content="Keep editing" Style="{StaticResource SecondarySmall}"
                    Click="OnKeepEditingClick"/>
            <Button Content="Discard" Style="{StaticResource DangerSmall}" Margin="8,0,0,0"
                    Click="OnDiscardClick"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="4" Margin="8,6,8,8">
        <Border x:Name="Field" Style="{StaticResource EditorField}" Padding="0">
          <!-- The page paints its own rounded canvas; the frame edge belongs to the WPF border. -->
          <wv2:WebView2 x:Name="Web" AutomationProperties.Name="Clip content"/>
        </Border>
      </Grid>

      <!-- Footer shares the 8 DIP content gutter, so Save's edge lines up with the text field. -->
      <Border Grid.Row="5" Padding="8,14" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource KeycapText}"/></Border>
          <Button Content="Cancel" Style="{StaticResource Secondary}" Margin="8,0,0,0"
                  Click="OnCancelClick" ToolTip="Cancel (Esc)"/>
          <Border Style="{StaticResource Keycap}" Margin="16,0,0,0"><TextBlock Text="Ctrl+S" Style="{StaticResource KeycapText}"/></Border>
          <Button x:Name="SaveButton" Content="Save changes" Style="{StaticResource Primary}" Margin="8,0,0,0"
                  Click="OnSaveClick" ToolTip="Save changes (Ctrl+S)"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
