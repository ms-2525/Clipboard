<Window x:Class="Clip.UI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        SizeToContent="Height">

  <Border x:Name="Root" Background="{StaticResource Surface}" CornerRadius="12"
          BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="14,10"
          Opacity="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
    </Border.Effect>

    <Grid TextElement.FontFamily="{StaticResource UiFont}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
          <TextBlock x:Name="AppName" Foreground="{StaticResource Accent}" FontSize="12"
                     FontWeight="SemiBold"/>
          <TextBlock x:Name="Time" Foreground="{StaticResource Muted}" FontSize="11"
                     FontStyle="Italic" Margin="10,1,0,0"/>
        </StackPanel>

        <Border x:Name="CloseHit" Grid.Column="1" Background="Transparent"
                Padding="5,1" Margin="0,-6,-8,0" VerticalAlignment="Top" Cursor="Hand">
          <TextBlock Text="✕" FontSize="11">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMouseOver, ElementName=CloseHit}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
      </Grid>

      <Image x:Name="ThumbImg" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
             Margin="0,2,0,0" Visibility="Collapsed"/>

      <TextBlock Grid.Row="1" x:Name="Body" Foreground="{StaticResource Fg}" FontSize="13"
                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border>
</Window>
