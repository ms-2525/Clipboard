<Window x:Class="Clip.UI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" Background="{DynamicResource Surface}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Border x:Name="Root" Background="{DynamicResource Surface}" CornerRadius="12"
          BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Padding="16,14"
          Opacity="0">

    <Grid TextElement.FontFamily="{StaticResource UiFont}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock x:Name="AppName" Foreground="{DynamicResource AccentText}" FontSize="{DynamicResource FontCaptionSize}"
                     LineHeight="{DynamicResource FontCaptionLine}"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="Time" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource FontMicroSize}"
                     LineHeight="{DynamicResource FontMicroLine}"
                     VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Pinned to the toast's top-right corner with a 32 DIP target: the same corner
             placement as every other close in the app, just easier to hit. -->
        <Button x:Name="CloseHit" Grid.Column="1" Style="{StaticResource IconButton}"
                Width="32" Height="32" Margin="0,-7,-6,0"
                VerticalAlignment="Top" Foreground="{DynamicResource Fg55}"
                AutomationProperties.Name="Dismiss notification" ToolTip="Dismiss">
          <Viewbox Width="12" Height="12">
            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Fg55}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Viewbox>
        </Button>
      </Grid>

      <Image x:Name="ThumbImg" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
             Margin="0,4,0,0" Visibility="Collapsed"/>

      <TextBlock Grid.Row="1" x:Name="Body" Foreground="{DynamicResource Fg}" FontSize="{DynamicResource FontBodySize}"
                 LineHeight="{DynamicResource FontBodyLine}"
                 Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border>
</Window>
