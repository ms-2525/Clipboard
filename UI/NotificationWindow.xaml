<Window x:Class="Clip.UI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" Background="{DynamicResource Raised}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto">

  <Border x:Name="Root" Background="{DynamicResource Raised}" CornerRadius="10"
          BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Padding="10,8"
          Opacity="0">

    <Grid TextElement.FontFamily="{StaticResource UiFont}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
          <TextBlock x:Name="AppName" Foreground="{DynamicResource Fg48}" FontSize="{DynamicResource FontMicroSize}"
                     LineHeight="{DynamicResource FontMicroLine}"
                     FontWeight="Normal" VerticalAlignment="Center"/>
          <TextBlock x:Name="Time" Foreground="{DynamicResource Fg48}" FontSize="{DynamicResource FontMicroSize}"
                     LineHeight="{DynamicResource FontMicroLine}"
                     VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Pinned to the toast's top-right corner: same placement as every other
             close in the app, kept small so a short toast stays short. -->
        <Button x:Name="CloseHit" Grid.Column="1" Style="{StaticResource IconButton}"
                Width="24" Height="24" Margin="0,-4,-4,0"
                VerticalAlignment="Top" Foreground="{DynamicResource Fg40}"
                AutomationProperties.Name="Dismiss notification" ToolTip="Dismiss">
          <Viewbox Width="10" Height="10">
            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Fg40}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Viewbox>
        </Button>
      </Grid>

      <Image x:Name="ThumbImg" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
             Margin="0,6,0,0" Visibility="Collapsed"/>

      <TextBlock Grid.Row="1" x:Name="Body" Foreground="{DynamicResource Fg75}" FontSize="{DynamicResource FontToastBodySize}"
                 LineHeight="{DynamicResource FontToastBodyLine}"
                 Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border>
</Window>
