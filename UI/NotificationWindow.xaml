<Window x:Class="Clip.UI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" Background="{DynamicResource Surface}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Border x:Name="Root" Background="{DynamicResource Surface}" CornerRadius="8"
          BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Padding="14,12"
          Opacity="0">

    <Grid TextElement.FontFamily="{StaticResource UiFont}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock x:Name="AppName" Foreground="{DynamicResource Accent}" FontSize="12"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="Time" Foreground="{DynamicResource Muted}" FontSize="11"
                     VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <Button x:Name="CloseHit" Grid.Column="1" Style="{StaticResource IconButton}"
                VerticalAlignment="Center" Foreground="{DynamicResource Fg55}"
                AutomationProperties.Name="Dismiss notification" ToolTip="Dismiss">
          <Viewbox Width="10" Height="10">
            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Fg55}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Viewbox>
        </Button>
      </Grid>

      <Image x:Name="ThumbImg" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
             Margin="0,4,0,0" Visibility="Collapsed"/>

      <TextBlock Grid.Row="1" x:Name="Body" Foreground="{DynamicResource Fg}" FontSize="13"
                 Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border>
</Window>
