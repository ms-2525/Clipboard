<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    THE button grammar (docs\CHECKLIST-uiux.md §1). One token-driven system for every surface:
    Primary (accent fill + OnAccent ink), Secondary (Raised + ControlLine), Ghost (transparent →
    4 % hover), Danger (Error border/ink). States: hover 4 % tint, pressed 8 %, disabled Fg48,
    keyboard-only 2 px AccentText ring (FocusVisualStyle is what WPF shows for keyboard focus only).
    Heights 36 default / 32 in a bar / 28 toolbar and icon. Radius 8. Colours live in the themes.
  -->

  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource AccentText}" BorderThickness="2"
                  CornerRadius="10" Margin="-3"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontSize" Value="{DynamicResource FontBodySize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
    <Setter Property="Background" Value="{DynamicResource Raised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
            <Border x:Name="State" Background="{DynamicResource StateHover}" CornerRadius="8" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="State" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="State" Property="Background" Value="{DynamicResource StatePressed}"/>
              <Setter TargetName="State" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Fg48}"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{DynamicResource AccentText}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
  </Style>

  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{DynamicResource Raised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
  </Style>

  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg55}"/>
  </Style>

  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Error}"/>
    <Setter Property="Foreground" Value="{DynamicResource Error}"/>
  </Style>

  <!-- Bar/row sizes: one step down from the default surface height. -->
  <Style x:Key="PrimarySmall" TargetType="Button" BasedOn="{StaticResource Primary}">
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style x:Key="SecondarySmall" TargetType="Button" BasedOn="{StaticResource Secondary}">
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style x:Key="GhostSmall" TargetType="Button" BasedOn="{StaticResource Ghost}">
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style x:Key="DangerSmall" TargetType="Button" BasedOn="{StaticResource Danger}">
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
  </Style>

  <!-- A bare 24 px icon target (✕, +): transparent, 4 % hover tint, no chrome. -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg48}"/>
  </Style>

  <!-- Toggle grammar: unchecked = Ghost, checked = the surface's affirmative (accent fill). -->
  <Style x:Key="ToggleGhost" TargetType="ToggleButton">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontSize" Value="{DynamicResource FontBodySize}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg55}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
            <Border x:Name="State" Background="{DynamicResource StateHover}" CornerRadius="8" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="State" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentText}"/>
              <Setter TargetName="Fill" Property="BorderBrush" Value="Transparent"/>
              <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Fg48}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toolbar grammar: 28 px, boxed (owner request), every content on one 20 px line block. -->
  <Style x:Key="ToolButton" TargetType="Button">
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="30"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="FontSize" Value="{DynamicResource FontBodySize}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
            <Border x:Name="State" Background="{DynamicResource StateHover}" CornerRadius="8" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="State" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="State" Property="Background" Value="{DynamicResource StatePressed}"/>
              <Setter TargetName="State" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Fg48}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A toolbar toggle reads as an active format: Surface fill + 1 px accent line when checked;
       unchecked shows the same ControlLine box as every other toolbar button. -->
  <Style x:Key="ToolToggle" TargetType="ToggleButton">
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="30"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="FontSize" Value="{DynamicResource FontBodySize}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
            <Border x:Name="State" Background="{DynamicResource StateHover}" CornerRadius="8" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="State" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Surface}"/>
              <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
              <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
