<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The WPF button grammar still needed by the shell: the toast's close (IconButton), the
    clear-history dialog's Secondary/Danger small buttons, and the safety net below so a
    code-built button never shows stock chrome. The React page owns every other control and
    its own CSS; the fuller grammar (Primary/Ghost/toolbar/toggle) went with the old UI.
  -->

  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource AccentText}" BorderThickness="2"
                  CornerRadius="10" Margin="-3"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontSize" Value="{DynamicResource FontBodySize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
    <Setter Property="Background" Value="{DynamicResource Raised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
            <Border x:Name="State" Background="{DynamicResource StateHover}" CornerRadius="8" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="State" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="State" Property="Background" Value="{DynamicResource StatePressed}"/>
              <Setter TargetName="State" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Fg48}"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{DynamicResource Raised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg75}"/>
  </Style>

  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Error}"/>
    <Setter Property="Foreground" Value="{DynamicResource Error}"/>
  </Style>

  <!-- Bar/row sizes: one step down from the default surface height. -->
  <Style x:Key="SecondarySmall" TargetType="Button" BasedOn="{StaticResource Secondary}">
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style x:Key="DangerSmall" TargetType="Button" BasedOn="{StaticResource Danger}">
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
  </Style>

  <!-- A 28 px icon target: transparent fill + ControlLine edge, 4 % hover tint. -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg48}"/>
  </Style>

  <!-- Safety net: a Button with no explicit Style still gets the bordered grammar,
       never stock WPF chrome. Explicit styles above win where set. -->
  <Style TargetType="Button" BasedOn="{StaticResource Secondary}"/>

</ResourceDictionary>
