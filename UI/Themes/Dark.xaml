<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Manrope</FontFamily>

  <!-- Surfaces (docs\DESIGN-contrast.md §0.3) -->
  <SolidColorBrush x:Key="App"      Color="#08090C"/>
  <SolidColorBrush x:Key="Surface"  Color="#13151B"/>
  <SolidColorBrush x:Key="Raised"   Color="#1C1F28"/>
  <SolidColorBrush x:Key="Field"    Color="#1F2126"/>

  <!-- Text levels: three, no fourth grey (docs\DESIGN-typography.md §3) -->
  <SolidColorBrush x:Key="Fg"       Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Fg75"     Color="#C4C5C6"/>
  <SolidColorBrush x:Key="Fg55"     Color="#959698"/>
  <SolidColorBrush x:Key="Fg48"     Color="#848588"/>
  <SolidColorBrush x:Key="Fg40"     Color="#70737A"/>
  <SolidColorBrush x:Key="Fg35"     Color="#66676B"/>
  <!-- Kept for existing surfaces; no text uses it after the type pass. -->
  <SolidColorBrush x:Key="Muted"    Color="#9BA1AC"/>
  <SolidColorBrush x:Key="Placeholder" Color="#82868F"/>

  <SolidColorBrush x:Key="Hairline" Color="#262A35"/>
  <SolidColorBrush x:Key="Divider"  Color="#212329"/>

  <!-- Accent is a fill; AccentText is accent-coloured type/rails (DESIGN-contrast §4) -->
  <SolidColorBrush x:Key="Accent"     Color="#FF8A3D"/>
  <SolidColorBrush x:Key="AccentText" Color="#FF8A3D"/>
  <SolidColorBrush x:Key="OnAccent"   Color="#08090C"/>
  <SolidColorBrush x:Key="ControlLine" Color="#666C7C"/>
  <SolidColorBrush x:Key="Error"      Color="#FF6B6B"/>

  <!-- Semantic rails (Ortu): sage success, amber pinned, sky URL, violet code -->
  <SolidColorBrush x:Key="Sage"   Color="#AEB291"/>
  <SolidColorBrush x:Key="Amber"  Color="#FBBF24"/>
  <SolidColorBrush x:Key="Sky"    Color="#38BDF8"/>
  <SolidColorBrush x:Key="Violet" Color="#A78BFA"/>

  <!-- Row separation (RESEARCH-clipboardapps\copyq-forest.md §3): the odd-row fill and an alpha hover,
       so a hover tints the zebra instead of replacing it. 4 % white over App = the old #121316. -->
  <SolidColorBrush x:Key="RowAlt"        Color="#16181D"/>
  <SolidColorBrush x:Key="RowHover"      Color="#0AFFFFFF"/>

  <!-- State tints capped at 8 % (DESIGN-contrast §5.3) -->
  <SolidColorBrush x:Key="StateHover"    Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="StatePressed"  Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="RowSelected"   Color="#1C1310"/>
  <SolidColorBrush x:Key="SelectionRing" Color="#3E2517"/>
  <LinearGradientBrush x:Key="SelectionRail" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF8A3D"/>
    <GradientStop Offset="1" Color="#FF6B1A"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PulseFill" Color="#141515"/>
  <SolidColorBrush x:Key="PulseRing" Color="#3A3C34"/>

  <SolidColorBrush x:Key="KeycapBackground" Color="#26282D"/>
  <SolidColorBrush x:Key="KeycapLine"       Color="#3B3D40"/>
  <SolidColorBrush x:Key="BadgeBackground"  Color="#1F2126"/>
  <SolidColorBrush x:Key="TileBackground"   Color="#1F2126"/>
  <SolidColorBrush x:Key="ScrollThumb"      Color="#404249"/>

</ResourceDictionary>
