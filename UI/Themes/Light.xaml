<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
  <FontFamily x:Key="MonoFont">pack://application:,,,/Assets/Fonts/#IBM Plex Mono</FontFamily>

  <!-- LAYER A only: application chrome. Rich content (LAYER B) never reads these. -->
  <!-- Surfaces: warm paper, white cards -->
  <SolidColorBrush x:Key="App"      Color="#F7F5F1"/>
  <SolidColorBrush x:Key="Surface"  Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Raised"   Color="#FCFBF9"/>
  <SolidColorBrush x:Key="Field"    Color="#F3F1EC"/>

  <!-- Text levels -->
  <SolidColorBrush x:Key="Fg"       Color="#1C1B1A"/>
  <SolidColorBrush x:Key="Fg75"     Color="#44403C"/>
  <SolidColorBrush x:Key="Fg55"     Color="#78716C"/>
  <SolidColorBrush x:Key="Fg48"     Color="#A8A29E"/>
  <SolidColorBrush x:Key="Fg40"     Color="#C4BFB9"/>
  <SolidColorBrush x:Key="Fg35"     Color="#D6D3D1"/>
  <SolidColorBrush x:Key="Muted"    Color="#78716C"/>
  <SolidColorBrush x:Key="Placeholder" Color="#A8A29E"/>

  <SolidColorBrush x:Key="Hairline" Color="#E7E2D9"/>
  <SolidColorBrush x:Key="Divider"  Color="#ECE8E1"/>

  <!-- Restrained blue accent: fill for buttons, darker ink for text on white -->
  <SolidColorBrush x:Key="Accent"     Color="#2E6BEE"/>
  <SolidColorBrush x:Key="AccentText" Color="#1D4FD7"/>
  <SolidColorBrush x:Key="OnAccent"   Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ControlLine" Color="#DCD6CB"/>
  <SolidColorBrush x:Key="Error"      Color="#C92A2A"/>

  <SolidColorBrush x:Key="Sage"   Color="#5B7A5B"/>
  <SolidColorBrush x:Key="Amber"  Color="#92600A"/>
  <SolidColorBrush x:Key="Sky"    Color="#0369A1"/>
  <SolidColorBrush x:Key="Violet" Color="#6D28D9"/>

  <!-- Rows: no zebra band; hover is a warm-black 5% veil, selection a pale blue tint -->
  <SolidColorBrush x:Key="RowAlt"        Color="#FAF9F7"/>
  <SolidColorBrush x:Key="RowHover"      Color="#0D1C1917"/>
  <SolidColorBrush x:Key="StateHover"    Color="#0D1C1917"/>
  <SolidColorBrush x:Key="StatePressed"  Color="#141C1917"/>
  <SolidColorBrush x:Key="RowSelected"   Color="#EDF2FD"/>
  <SolidColorBrush x:Key="SelectionRing" Color="#C9D9F8"/>
  <SolidColorBrush x:Key="SelectionRail" Color="#2E6BEE"/>
  <SolidColorBrush x:Key="PulseFill" Color="#F1EEE9"/>
  <SolidColorBrush x:Key="PulseRing" Color="#D6D0C7"/>

  <SolidColorBrush x:Key="KeycapBackground" Color="#F1EEE8"/>
  <SolidColorBrush x:Key="KeycapLine"       Color="#E0DAD1"/>
  <SolidColorBrush x:Key="BadgeBackground"   Color="#F3F1EC"/>
  <SolidColorBrush x:Key="TileBackground"    Color="#F7F5F1"/>
  <SolidColorBrush x:Key="ScrollThumb"      Color="#D6D0C7"/>

  <!-- LAYER B defaults: original-content fallbacks owned by the content layer.
       App chrome must not reference these; content rendering must not reference LAYER A. -->
  <SolidColorBrush x:Key="ContentCanvas" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ContentInk" Color="#1C1917"/>
  <SolidColorBrush x:Key="ContentLink" Color="#1D4FD8"/>
  <SolidColorBrush x:Key="ContentDarkBg" Color="#23272E"/>
  <SolidColorBrush x:Key="ContentMatchBg" Color="#FEF3C7"/>

</ResourceDictionary>
