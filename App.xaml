<Application x:Class="Clip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/UI/Themes/Dark.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/UI/Themes/Icons.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/UI/Themes/Buttons.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/UI/Themes/Popups.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/UI/RowTemplate.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
