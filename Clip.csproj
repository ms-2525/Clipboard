<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows version is what makes Windows.Media.Ocr (offline OCR) available; the SDK adds its
         projection assemblies by itself. Measured cost: +25.4 MB on the single exe, no extra package. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <!-- The owner build is one exe; reference XML docs are not runtime files. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <!-- RENAME THE PRODUCT HERE — everything user-visible (exe name, %APPDATA% folder, tray label, mutex) derives from AssemblyName at runtime; namespaces stay internal and never need changing. -->
    <AssemblyName>Clip</AssemblyName>
    <RootNamespace>Clip</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\clip.ico</ApplicationIcon>
    <!-- The editor page's npm install is a build-time-only dependency, never app content. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);scripts\editor\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- _fonttest is a scratch experiment, not part of the app -->
  <ItemGroup>
    <Compile Remove="_fonttest\**" />
    <Page Remove="_fonttest\**" />
    <!-- "Ortu Reference" is the owner-requested local clone of the Ortu repo (design reference only — never compiled) -->
    <Compile Remove="Ortu Reference\**" />
    <Page Remove="Ortu Reference\**" />
    <None Remove="Ortu Reference\**" />
    <Resource Remove="Ortu Reference\**" />
  </ItemGroup>

  <!-- Static faces: WPF cannot drive a variable font's wght axis, so 400/500/600 ship as three files.
       Inter (SIL OFL) is the owner-picked face; IBM Plex Mono renders the row-number chips. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Inter-Regular.ttf" />
    <Resource Include="Assets\Fonts\Inter-Medium.ttf" />
    <Resource Include="Assets\Fonts\Inter-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\IBMPlexMono-Regular.ttf" />
  </ItemGroup>

  <!-- The editor page ships inside the exe: the host serves these three over https://clip/. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\editor\editor.html" LogicalName="clip.assets.editor.html" />
    <EmbeddedResource Include="Assets\editor\editor.css" LogicalName="clip.assets.editor.css" />
    <EmbeddedResource Include="Assets\editor\editor.bundle.js" LogicalName="clip.assets.editor.bundle.js" />
  </ItemGroup>

  <!-- The final web UI ships inside the exe too: ShellWindow serves clip.assets.web/<path> from memory
       over https://clip.local/, so a published Clip.exe needs no folder beside it. The glob is empty when
       UI\web\dist has not been built yet, and the shell then shows its explicit fallback page. -->
  <ItemGroup>
    <EmbeddedResource Include="UI\web\dist\**\*"
                      Exclude="UI\web\dist\**\*.map"
                      LogicalName="clip.assets.web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
