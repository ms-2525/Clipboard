<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <!-- RENAME THE PRODUCT HERE — everything user-visible (exe name, %APPDATA% folder, tray label, mutex) derives from AssemblyName at runtime; namespaces stay internal and never need changing. -->
    <AssemblyName>Clip</AssemblyName>
    <RootNamespace>Clip</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- _fonttest is a scratch experiment, not part of the app -->
  <ItemGroup>
    <Compile Remove="_fonttest\**" />
    <Page Remove="_fonttest\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\Manrope.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="HtmlRenderer.WPF" Version="1.6.1" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
  </ItemGroup>

</Project>
