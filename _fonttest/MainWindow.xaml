<Window x:Class="fonttest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Font Test" Height="620" Width="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" Top="70" Left="70">

  <Window.Resources>
    <!-- Embedded font: works even though Manrope is NOT installed on this machine -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Manrope</FontFamily>

    <SolidColorBrush x:Key="App"      Color="#08090C"/>
    <SolidColorBrush x:Key="Surface"  Color="#13151B"/>
    <SolidColorBrush x:Key="Raised"   Color="#1C1F28"/>
    <SolidColorBrush x:Key="Fg"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted"    Color="#8A909C"/>
    <SolidColorBrush x:Key="Accent"   Color="#FF8A3D"/>
    <SolidColorBrush x:Key="Hairline" Color="#262A35"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource App}" CornerRadius="14"
          BorderBrush="#2A2E3A" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
    </Border.Effect>

    <Grid Margin="16" TextElement.FontFamily="{StaticResource UiFont}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="2,0,2,12">
        <TextBlock Text="Manrope embedded" Foreground="{StaticResource Fg}"
                   FontSize="17" FontWeight="Bold"/>
        <TextBlock Text="If this renders in a geometric sans, the font loaded from the app, not the system."
                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Row="1" Background="{StaticResource Raised}" CornerRadius="8"
              BorderBrush="{StaticResource Hairline}" BorderThickness="1"
              Padding="10,9" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                     Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="Search clipboard..." FontSize="13"
                     Foreground="#5C6270" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
        <Border Background="{StaticResource Raised}" CornerRadius="7" Padding="14,6" Margin="0,0,6,0">
          <TextBlock Text="Clipboard" Foreground="{StaticResource Fg}" FontSize="12" FontWeight="SemiBold"/>
        </Border>
        <Border Background="Transparent" CornerRadius="7" Padding="14,6">
          <TextBlock Text="Images" Foreground="{StaticResource Muted}" FontSize="12"/>
        </Border>
      </StackPanel>

      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Hidden">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Foreground="{StaticResource Fg}" FontSize="13" TextWrapping="Wrap"
                         LineHeight="19" MaxHeight="76" TextTrimming="CharacterEllipsis"
                         Text="One snag, already worked around for this ticket: a brand-new copy of the app cannot install its libraries with the older npm, so I pinned the list. This line exists to prove wrapping and the two-line clamp behave."/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontStyle="Italic"
                         Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                         Text="Grok  ·  23 Nov 2026 09:47"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Background="{StaticResource Raised}" BorderBrush="#333849">
            <StackPanel>
              <TextBlock Foreground="{StaticResource Fg}" FontSize="13" TextWrapping="Wrap"
                         Text="https://github.com/abhijith-p-subash/ortu"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontStyle="Italic"
                         Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                         Text="GitHub - abhijith-p-subash/ortu · Local-first clipboard history  ·  23 Nov 2026 09:41"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Foreground="{StaticResource Fg}" FontSize="13" TextWrapping="Wrap"
                         Text="Which subscriptions give the most usage? : r/DeepSeek — [InPrivate] — Microsoft Edge"/>
              <TextBlock Margin="0,7,0,0">
                <Run Text="Microsoft Edge  ·  23 Nov 2026 09:09"
                     Foreground="{StaticResource Muted}" FontSize="11" FontStyle="Italic"/>
              </TextBlock>
            </StackPanel>
          </Border>

          <Border Background="Transparent" Padding="4,14,0,0">
            <TextBlock Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                       Text="Accent #FF8A3D · Manrope Semibold"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
